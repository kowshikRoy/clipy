    "Allow Clipy in Accessibility Settings to paste directly." : {
      "localizations" : {
        "bn" : { "stringUnit" : { "state" : "translated", "value" : "সরাসরি পেস্ট করতে অ্যাক্সেসিবিলিটি সেটিংসে Clipy অনুমোদন করুন।" } },
