        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Autorisez Clipy dans Accessibilité pour coller directement." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "直接貼り付けるにはアクセシビリティ設定でClipyを許可してください。" } },
