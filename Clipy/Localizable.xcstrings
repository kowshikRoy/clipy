    "Auto-clean large transient copies (>30 days old, >1,000 chars)" : {
      "localizations" : {
        "bn" : { "stringUnit" : { "state" : "translated", "value" : "বড় অস্থায়ী কপি স্বয়ংক্রিয়ভাবে মুছুন (>৩০ দিন পুরনো, >১,০০০ অক্ষর)" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Große temporäre Einträge automatisch bereinigen (>30 Tage, >1.000 Zeichen)" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Limpiar copias grandes antiguas (>30 días, >1.000 caracteres)" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Nettoyer les grands textes temporaires (>30 jours, >1 000 caract.)" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "大きな一時コピーを自動 정리（30日以上経過・1,000文字超）" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "대용량 임시 항목 자동 정리 (30일 경과, 1,000자 초과)" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Grote tijdelijke items automatisch wissen (>30 dagen, >1.000 tekens)" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动清理大段临时复制内容（超过 30 天且大于 1,000 字符）" } }
      }
    },
    "Auto-clean noise & whitespace snippets (>30 days old)" : {
      "localizations" : {
        "bn" : { "stringUnit" : { "state" : "translated", "value" : "অপ্রয়োজনীয় ও ফাঁকা স্নিপেট স্বয়ংক্রিয়ভাবে মুছুন (>৩০ দিন পুরনো)" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Leerzeichen- & Kurz-Snippets automatisch bereinigen (>30 Tage)" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Limpiar fragmentos vacíos o ruido (>30 días)" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Nettoyer les extraits vides ou courts (>30 jours)" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "空白・不要な断片を自動削除（30日以上経過）" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "공백 및 불필요한 짧은 조각 자동 정리 (30일 경과)" } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Korte/lege fragmenten automatisch wissen (>30 dagen)" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动清理空白和简短无用片段（超过 30 天）" } }
      }
    },
    "Automatically remove unpinned, untagged items that might not ever be needed. (Pinned and tagged items are permanently preserved)." : {
      "localizations" : {
        "bn" : { "stringUnit" : { "state" : "translated", "value" : "আনপিন ও ট্যাগবিহীন পুরনো আইটেম স্বয়ংক্রিয়ভাবে মুছে ফেলুন। (পিন ও ট্যাগ করা আইটেম স্থায়ীভাবে সংরক্ষিত থাকে)।" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Nicht angeheftete Elemente ohne Notiz automatisch entfernen. (Angeheftete und markierte Elemente bleiben dauerhaft erhalten)." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Elimina automáticamente los elementos no fijados ni etiquetados. (Los elementos fijados o con nota se conservan siempre)." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Supprimer automatiquement les éléments non épinglés et sans note. (Les éléments épinglés ou annotés sont conservés)." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ピン留めやタグのない古い項目を自動削除します（ピン留め・タグ付き項目は永続的に保持されます）。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "고정되지 않고 태그가 없는 오래된 항목을 자동 삭제합니다. (고정 및 태그된 항목은 영구 보관됩니다)." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Verwijder automatisch niet-vastgezette items zonder label. (Vastgezette items blijven altijd bewaard)." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "自动移除未置顶且无标签的旧项目（置顶和带备注的项目将永久保留）。" } }
      }
    },
